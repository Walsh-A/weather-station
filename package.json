{
  "name": "home-station",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p none \"tsx watch server/server.ts\" \"rspack serve --mode development\"",
    "dev:client": "rspack serve --mode development",
    "dev:server": "tsx watch server/server.ts",
    "build": "rspack build --mode production",
    "server": "tsx watch server/server.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"client/**/*.{ts,tsx,css}\" \"public/**/*.{html,css}\" \"*.json\" \"*.md\" \"*.ts\"",
    "format:check": "prettier --check \"client/**/*.{ts,tsx,css}\" \"public/**/*.{html,css}\" \"*.json\" \"*.md\" \"*.ts\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/lab": "^9.0.0-beta.9",
    "@mui/material": "^9.4.0",
    "express": "5.2.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@rspack/cli": "2.1.10",
    "@rspack/core": "2.1.10",
    "@rspack/dev-server": "2.2.0",
    "@types/express": "5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "concurrently": "10.0.5",
    "css-loader": "7.1.4",
    "prettier": "3.9.6",
    "style-loader": "4.0.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
